  "sample_counts": {"real_train": 46, "legacy_train": 45, "focused_train": 63, "legacy_val": 108, "focused_val": 90},
  "evaluation": {"conf": 0.25, "iou": 0.7, "match_iou": 0.5, "imgsz": 640, "agnostic_nms": true, "retina_masks": true},
  "initial_models": {
