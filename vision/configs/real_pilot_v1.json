{
  "version": 1,
  "dataset": "dataset/real_mixed_pilot_v1",
  "output": "runs/segment/real_mixed_pilot_v1",
  "review": "dataset/real/annotations/review_v2",
  "legacy_dataset": "dataset/stl_synthetic_yolo",
  "focused_dataset": "dataset/focused_v2",
  "seed": 42,
  "training": {
    "epochs": 3,
    "imgsz": 640,
    "batch": 4,
    "device": "cpu",
    "threads": 2,
    "workers": 0,
    "lr0": 0.0003,
    "patience": 3,
    "warmup_epochs": 1.0,
    "optimizer": "AdamW",
    "amp": false,
    "cache": false,
    "mosaic": 0.0,
    "mixup": 0.0,
    "copy_paste": 0.0,
    "degrees": 10.0,
    "translate": 0.05,
    "scale": 0.2,
    "shear": 0.0,
    "perspective": 0.0,
    "fliplr": 0.5,
    "flipud": 0.0,
    "hsv_h": 0.05,
    "hsv_s": 0.5,
    "hsv_v": 0.35,
    "overlap_mask": true,
