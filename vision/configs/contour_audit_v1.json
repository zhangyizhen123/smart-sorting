{
  "version": 1,
  "dataset": "dataset/real_mixed_pilot_v1",
  "output": "runs/segment/contour_audit_v1",
  "models": {
    "initial": "models/trained/stl_shape_v1/best.pt",
    "pilot": "runs/segment/real_mixed_pilot_v1/from_v1/weights/best.pt"
