  "candidates": {
    "smoke_best": {"model": "runs/experiments/pilot_s01_smoke_train_v1/train/weights/best.pt",
                   "settings": {"imgsz": 640, "conf": 0.25, "iou": 0.7, "device": 0, "retina_masks": true}}
  }
}
